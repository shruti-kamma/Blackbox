.next/
out/
build/
dist/

# Env
.env
.env.local
.env.*.local

# Turbo
.turbo/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Prisma
packages/db/generated/

# Crawler/scoring-agent output (bulk-downloaded/generated, not source — keep data/keywords/ etc. tracked)
services/*/data/reports/
services/*/data/annual_reports/
services/*/data/trimmed_pdfs/
services/*/data/pwd_extractions/
services/*/data/scores/
services/*/data/*.json

# Testing
coverage/
playwright-report/
test-results/

# Stakeholder handoff docs — generated per-request, not project source
docs/handoff/

# Reference/sample source documents (e.g. annual reports) — large binaries,
# kept locally for pipeline testing, not committed
docs/samples/

# Uploaded files (candidate resumes, etc.) — local disk storage, dev only
apps/job-portal/uploads/

# Vercel project link (local machine's link to the hosted project, not
# something every clone/environment should share)
.vercel/
