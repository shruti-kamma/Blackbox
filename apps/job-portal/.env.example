DATABASE_URL="postgresql://blackbox:blackbox@localhost:5432/blackbox?schema=public"
REDIS_URL="redis://localhost:6379/0"
AUTH_SECRET="replace-with-a-long-random-string"

# Free, no billing account required — sign up at https://console.groq.com,
# used to generate the 10 personalized skill-based assessment questions, see
# src/lib/assessment/skill-question-generator.ts.
GROQ_API_KEY=

# Used only by the optional disability-certificate consistency check
# (lib/disability-verification/) — this project's Groq tier has no
# vision-capable model available, confirmed directly against the API, so
# that one feature uses Anthropic's vision API instead. Shared with
# services/scoring-agent and services/matching-agent, which already use it.
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5 if unset.
CLAUDE_VISION_MODEL=

# Dedicated secret for hashing disability-certificate numbers — never the
# raw number, only a deterministic HMAC, so a duplicate certificate can be
# detected without ever storing it. Not the same as AUTH_SECRET.
CERT_HASH_SECRET="replace-with-a-long-random-string"

# Candidate signup KYC: no real email/SMS provider wired up yet, so codes
# are logged server-side (and echoed in the API response) instead of sent.
# Set to "false" once a real provider is wired into src/lib/kyc/senders.ts.
KYC_DEV_MODE=true

# Real providers, once chosen (uncomment and fill in when KYC_DEV_MODE=false):
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
