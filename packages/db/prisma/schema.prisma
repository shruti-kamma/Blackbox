// Shared schema for all Blackbox apps and agent services.
// Job-portal functionality here is intentionally minimal — it covers only what's
// been discussed so far (accounts, job postings, applications) and will grow as
// the rest of the job-portal feature set is scoped.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserRole {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum OrganizationType {
  COMPANY
  UNIVERSITY
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  INTERVIEWING
  OFFERED
  REJECTED
  WITHDRAWN
}

enum CrawlStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

// Controlled list for disability self-identification. "OTHER" pairs with the
// free-text CandidateProfile.disabilityOther field.
enum DisabilityCategory {
  VISUAL
  HEARING
  MOBILITY
  COGNITIVE
  SPEECH
  CHRONIC_ILLNESS
  MENTAL_HEALTH
  OTHER
}

enum EducationLevel {
  HIGH_SCHOOL
  DIPLOMA
  ASSOCIATE
  BACHELORS
  MASTERS
  DOCTORATE
  OTHER
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  LEAD
}

enum NotificationType {
  NEW_MATCH
  // Fired when an employer moves an application to INTERVIEWING and the
  // candidate's accommodationNeeds aren't fully covered by the job's
  // accommodationTypes — informational only, never blocks the transition.
  ACCOMMODATION_GAP
  // Fired when an employer rejects an application that had
  // Application.metEssentialCriteria set, without it ever reaching
  // INTERVIEWING — informational only, never blocks the transition. The
  // accountability mechanism for the guaranteed-interview badge (see
  // Job.offersGuaranteedInterview): deliberately a visible record rather
  // than an automatic penalty, since a single instance could have a
  // legitimate reason (role closed, candidate unresponsive, etc.).
  GUARANTEED_INTERVIEW_SKIPPED
}

// Controlled vocabulary for accommodations, mirroring DisabilityCategory's
// pattern: a closed enum the scoring engine can do exact-set overlap on,
// plus the existing free-text fields (CandidateProfile.accessibilityNeeds,
// Job.accommodationsOffered) stay as unscored supplementary notes.
enum AccommodationType {
  SCREEN_READER_SUPPORT
  SIGN_LANGUAGE_INTERPRETER
  CAPTIONING
  WHEELCHAIR_ACCESSIBLE_WORKSPACE
  ASSISTIVE_TECHNOLOGY_STIPEND
  FLEXIBLE_HOURS
  REMOTE_FRIENDLY
  ERGONOMIC_WORKSTATION
  ACCESSIBLE_TRANSPORTATION
  EXTENDED_BREAKS
  JOB_COACH_SUPPORT
  OTHER
}

// How a candidate prefers to be communicated with during the hiring
// process itself (interviews, calls, correspondence) — a different axis
// from AccommodationType (what the *workplace* provides) and
// AssistiveTechnology (what device/software they use). A candidate can
// have more than one, e.g. captions and extra response time together.
enum PreferredCommunicationMode {
  SIGN_LANGUAGE_INTERPRETER
  SCREEN_READER_COMPATIBLE
  CAPTIONS_OR_TRANSCRIPT
  EXTRA_RESPONSE_TIME
  WRITTEN_ONLY
  OTHER
}

enum VerificationChannel {
  EMAIL
  PHONE
}

// One-time codes for the candidate KYC gate (see User.emailVerified /
// phoneVerified). A new send invalidates prior unconsumed codes for the
// same (userId, channel) rather than allowing several to be live at once.
model VerificationCode {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    VerificationChannel
  codeHash   String
  expiresAt  DateTime
  attempts   Int                 @default(0)
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([userId, channel])
}

// Groups AssistiveTechnology entries for display/filtering — the specific
// entries themselves (JAWS, NVDA, crutches, ...) are an open, growing
// vocabulary (see AssistiveTechnology), not a closed enum like the one above.
enum AssistiveTechnologyType {
  MOBILITY_AID
  VISION_AID
  HEARING_AID
  COMMUNICATION_AID
  SCREEN_READER_SOFTWARE
  OTHER_SOFTWARE
  OTHER
}

// Which limb/region is affected — only meaningfully asked in the UI when a
// candidate's disability category is MOBILITY. Deliberately a small, stable
// enum (unlike AssistiveTechnology's open vocabulary).
enum BodyPart {
  LEFT_ARM
  RIGHT_ARM
  BOTH_ARMS
  LEFT_LEG
  RIGHT_LEG
  BOTH_LEGS
  HAND
  SPINE
  MULTIPLE
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  candidateProfile       CandidateProfile?
  notifications          Notification[]
  accommodationApprovals Application[]      @relation("ApplicationAccommodationApprover")
  verificationCodes      VerificationCode[]

  // KYC gate for candidates: signup creates the User immediately but every
  // other candidate route is blocked (see requireVerifiedCandidate) until
  // both flip true. Always true for EMPLOYER/ADMIN — KYC applies to
  // candidates only.
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  // Set when role = EMPLOYER; the company this user posts jobs on behalf of.
  employerOrgId String?
  employerOrg   Organization? @relation(fields: [employerOrgId], references: [id])

  // Asked once at EMPLOYER signup: "have you received training on hiring
  // people with disabilities?" Null = skipped (optional, not required to
  // sign up) or not applicable to this role. Internal-only for now — not
  // shown to candidates, since it's a self-reported claim with no
  // verification behind it yet; see the guaranteed-interview badge's
  // accountability design for the same reasoning applied there.
  hrTrainedOnDisabilityHiring Boolean?
  hrTrainingNotes             String?

  @@index([employerOrgId])
}

model CandidateProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName           String
  headline           String?
  phone              String?
  dateOfBirth        DateTime? @db.Date
  // An uploaded resume file, not a candidate-typed link — see
  // POST /api/candidate/resume-upload. resumeUrl holds the stored filename
  // (e.g. "<candidateProfileId>.pdf") used to locate the file on disk;
  // resumeFileName holds the original filename for display. Both are only
  // ever written by the upload route, never by the general profile PATCH.
  resumeUrl          String?
  resumeFileName     String?
  // Gates the one-time "autofill from resume vs. enter manually" choice
  // screen candidates see the first time they reach profile building — set
  // true the moment either path is chosen (see
  // POST /api/candidate/profile/onboarding-choice), not on full completion,
  // so leaving the form partway through never re-shows the choice screen.
  onboardingCompleted Boolean @default(false)
  accessibilityNeeds String[] // free-text supplementary notes, not read by scoring — see accommodationNeeds

  // Controlled disability self-identification, used as the first-pass filter
  // in matching. "OTHER" pairs with disabilityOther free text.
  disabilityCategories DisabilityCategory[]
  disabilityOther      String?

  // Controlled accommodation needs, scored against Job.accommodationTypes
  // by the matching engine's accommodationFit criterion.
  accommodationNeeds AccommodationType[]

  // How the candidate prefers to be communicated with during hiring itself
  // (interviews, calls, correspondence) — not read by matching, purely
  // informational for HR. Empty = no specific preference, a normal answer,
  // not an unanswered question (unlike accommodationNeeds, no "confirm
  // none" gate applies here).
  preferredCommunicationModes PreferredCommunicationMode[]

  // True once the candidate has explicitly confirmed "I don't need
  // accommodations" from the empty-needs prompt — distinguishes that from
  // simply never having filled the section in. Set once, not re-asked.
  confirmedNoAccommodationNeeds Boolean @default(false)

  experienceLevel     ExperienceLevel?
  preferredCategories String[] // job categories, free text controlled by frontend select
  preferredLocations  String[]
  openToRemote        Boolean          @default(false)

  education             Education[]
  workExperience        WorkExperience[]
  projects              Project[]
  certifications        Certification[]
  skills                CandidateSkill[]
  assistiveTechnologies CandidateAssistiveTechnology[]
  disabilityDetails     CandidateDisabilityDetail[]
  applications          Application[]
  matches               Match[]
  candidateAssessment   CandidateAssessment?
  employerReviews       EmployerReview[]

  // Populated by the matching agent from résumé/profile text. Query via raw SQL
  // (Prisma has no native vector query API) — see services/matching-agent.
  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // GIN indexes back the matching engine's cheap prefilter stage (Prisma
  // `hasSome`/`has` compile to Postgres `&&`/`@>`, which these indexes serve).
  @@index([disabilityCategories], type: Gin)
  @@index([preferredLocations], type: Gin)
  @@index([openToRemote])
}

model Education {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  level          EducationLevel
  fieldOfStudy   String?
  institution    String
  graduationYear Int?

  createdAt DateTime @default(now())

  @@index([candidateProfileId])
}

model WorkExperience {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  title       String
  company     String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?

  createdAt DateTime @default(now())

  @@index([candidateProfileId])
}

// Optional — shown on the generated resume only if the candidate has at
// least one entry. A hackathon/competition result is just a project with an
// award noted in its subtitle, so there's no separate model for that.
model Project {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  title       String
  subtitle    String? // e.g. a one-line project description, or an award/competition note
  techStack   String? // free text, e.g. "Python, TensorFlow, CNN, OpenCV"
  date        DateTime?
  description String? // one bullet per line, split on \n when rendered
  url         String?

  createdAt DateTime @default(now())

  @@index([candidateProfileId])
}

// Optional, same "only shown if present" behavior as Project.
model Certification {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  title  String
  issuer String?
  date   DateTime?
  url    String?

  createdAt DateTime @default(now())

  @@index([candidateProfileId])
}

// Structured skill vocabulary shared between candidates and job postings, so
// skills overlap can be computed as a set intersection rather than fuzzy text
// matching. Grows organically — API upserts by name.
model Skill {
  id       String  @id @default(cuid())
  name     String  @unique
  category String? // e.g. "technical", "soft", "language"

  candidates CandidateSkill[]
  jobs       JobSkill[]
}

model CandidateSkill {
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  skillId            String
  skill              Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([candidateProfileId, skillId])
  @@index([skillId])
}

// Open, growing vocabulary of specific assistive devices/software (JAWS,
// NVDA, crutches, a particular wheelchair model, ...) — same upsert-by-name
// pattern as Skill, deliberately not a closed enum since this list is never
// "done" the way DisabilityCategory or AccommodationType are.
model AssistiveTechnology {
  id   String                  @id @default(cuid())
  name String                  @unique
  type AssistiveTechnologyType

  candidates CandidateAssistiveTechnology[]
  jobs       JobAssistiveTechnology[]
}

model CandidateAssistiveTechnology {
  candidateProfileId    String
  candidateProfile      CandidateProfile    @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  assistiveTechnologyId String
  assistiveTechnology   AssistiveTechnology @relation(fields: [assistiveTechnologyId], references: [id], onDelete: Cascade)

  @@id([candidateProfileId, assistiveTechnologyId])
  @@index([assistiveTechnologyId])
}

// Per-category clinical/functional detail — one row per disability category
// a candidate has declared, so someone with both MOBILITY and VISUAL gets
// two rows, each holding only what's relevant to that category. Purely
// informational: never read by the matching engine, only displayed on the
// candidate's profile and on match/application cards for employers.
model CandidateDisabilityDetail {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  category           DisabilityCategory
  severityPercentage Int? // 0-100, disability certification percentage where applicable
  affectedBodyPart   BodyPart? // only asked in the UI when category = MOBILITY

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidateProfileId, category])
}

model Organization {
  id          String           @id @default(cuid())
  type        OrganizationType
  name        String           @unique
  website     String?
  description String?

  // Added for the public rankings site (apps/ranking under job-portal) —
  // see docs/plans/rankings-site-v1.md. industry/location/logoUrl are
  // nullable because the current BRSR pipeline has no company-metadata
  // classification step yet (see docs/decisions.md — "Scoring
  // methodology"); real companies loaded today have these null rather
  // than a guessed value. slug is backfilled for existing rows in the
  // migration that introduced this column — see its migration.sql.
  slug     String  @unique
  logoUrl  String?
  industry String?
  location String?

  employerUsers       User[]
  jobs                Job[]
  crawlRuns           CrawlRun[]
  crawlFindings       CrawlFinding[]
  accessibilityScores AccessibilityScore[]
  employerReviews     EmployerReview[]
  evidence            Evidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

// One row per cited fact pulled from a company's BRSR filing or annual
// report — an internal audit trail, never shown on the public site. Its
// only purpose: if a published score is ever questioned, we can point to
// the exact document, page, and quote that backed it (see
// docs/decisions.md — "Evidence repository").
//
// Not append-only like AccessibilityScore — this is "the current best
// citation set" for an org+fiscal-year, not a history, so
// load_evidence.py replaces an org's rows wholesale on each reload rather
// than accumulating duplicates across re-extractions.
model Evidence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fyFrom Int
  fyTo   Int
  metric String // one of the 10 scoring metrics, or "Unmapped" if the field isn't tied to one
  field  String // raw extraction schema field name, e.g. "policy_summary"
  quote  String
  source String // "BRSR" | "Annual Report"
  sourceDocument String // local_path of the source PDF this citation came from
  originalPage   Int?

  createdAt DateTime @default(now())

  @@index([organizationId, fyFrom, fyTo])
  @@index([organizationId, metric])
}

// A candidate's review of an employer's disability-inclusion practices —
// deliberately narrow (did they honor accommodations, was the process
// accessible) rather than a generic star rating, and gated to candidates
// with a real application on record (enforced in the API route, not here).
// One review per candidate per organization; @@unique makes re-submitting
// an update rather than a duplicate. Shown to other candidates anonymized
// (no candidate name) — see the review API route.
model EmployerReview {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  // Null = the candidate didn't request any accommodations (not applicable),
  // distinct from false ("requested, wasn't honored") — the submission form
  // forces a choice among all three, not a default.
  honoredAccommodations Boolean?
  accessibleProcess     Boolean
  comment               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, candidateProfileId])
  @@index([organizationId])
}

model Job {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title                 String
  description           String
  category              String
  location              String?
  remote                Boolean  @default(false)
  employmentType        String? // e.g. "full-time", "contract"
  accommodationsOffered String[] // free-text supplementary notes, not read by scoring — see accommodationTypes
  isOpen                Boolean  @default(true)

  // When true, the employer commits to interviewing any candidate who has
  // every skill marked JobSkill.essential — deliberately not tied to the
  // overall match score, which blends unrelated factors (location,
  // accommodation fit, ...) the employer didn't choose. See
  // Application.metEssentialCriteria for the per-application computed flag.
  offersGuaranteedInterview Boolean @default(false)

  // Empty array = open to all disability categories. Non-empty = the role is
  // specifically targeted/suited to these; used as the matching prefilter.
  targetDisabilityCategories DisabilityCategory[]

  // Controlled accommodations offered, scored against
  // CandidateProfile.accommodationNeeds by the accommodationFit criterion.
  accommodationTypes AccommodationType[]

  requiredEducationLevel  EducationLevel?
  requiredEducationField  String?
  requiredExperienceLevel ExperienceLevel?

  requiredSkills                 JobSkill[]
  preferredAssistiveTechnologies JobAssistiveTechnology[]
  applications                   Application[]
  matches                        Match[]

  // Populated by the matching agent from the job description. Query via raw SQL.
  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([isOpen])
  @@index([remote])
  @@index([location])
  @@index([targetDisabilityCategories], type: Gin)
}

model JobSkill {
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  // Must-have vs. nice-to-have, set by the employer at posting time. Only
  // meaningful when the job has offersGuaranteedInterview on. Column
  // defaults to true so rows from before this field existed read as "was
  // already required" rather than silently becoming optional; the job
  // creation route itself sets this explicitly per skill for every new job,
  // defaulting an unlisted skill to false (not essential) — an employer who
  // opts into the guarantee without naming any essential skills has stated
  // no particular bar, not "everything is mandatory."
  essential Boolean @default(true)

  @@id([jobId, skillId])
  @@index([skillId])
}

model JobAssistiveTechnology {
  jobId                 String
  job                   Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assistiveTechnologyId String
  assistiveTechnology   AssistiveTechnology @relation(fields: [assistiveTechnologyId], references: [id], onDelete: Cascade)

  @@id([jobId, assistiveTechnologyId])
  @@index([assistiveTechnologyId])
}

model Application {
  id          String            @id @default(cuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(SUBMITTED)
  coverNote   String?

  // Set when an employer declines a first-time accommodation need via
  // decline-accommodations — an honest, visible reason for an auto-reject
  // rather than a silent status change.
  rejectionReason String?

  // Snapshot of the Match.score at the time the candidate applied, so a
  // hiring manager can see "applied with a 78% match" even if the underlying
  // profile/job change later.
  matchScore Float?

  // A free-text accommodation request the candidate can send once the
  // application reaches INTERVIEWING — expressive beyond the fixed
  // accommodationNeeds checklist (e.g. a specific software version).
  accommodationRequestText   String?
  accommodationRequestSentAt DateTime?

  // Set once an employer explicitly confirms they can meet a first-time
  // accommodation need (see computeFirstTimeMissingAccommodations) — gates
  // the OFFERED transition when non-null is required. Null = not approved.
  accommodationsApprovedAt       DateTime?
  accommodationsApprovedByUserId String?
  accommodationsApprovedBy       User?     @relation("ApplicationAccommodationApprover", fields: [accommodationsApprovedByUserId], references: [id])

  // Computed once at creation time (see createApplicationFromMatch): true
  // when the job has offersGuaranteedInterview on and this candidate has
  // every skill the employer marked essential. Snapshotted rather than
  // recomputed live, same reasoning as matchScore above — an honest record
  // of what was true when they applied.
  metEssentialCriteria Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, candidateId])
}

// Platform-wide, one-time MCQ assessment, taken once after profile building
// and gating every job application from then on (not per-job — see
// requireAssessedCandidate). Replaces the old per-job AI interview.
enum AssessmentSection {
  LISTENING
  SPEAKING
  READING
  WRITING
  APTITUDE
  SKILL_BASED
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
}

// The static, curated question bank — language (LISTENING/SPEAKING/READING/
// WRITING) and APTITUDE sections only. The 10 SKILL_BASED questions per
// candidate are AI-generated at assessment-start time from their listed
// skills and never live here — see CandidateAssessmentAnswer, which
// snapshots question content directly rather than referencing this table.
model AssessmentQuestion {
  id           String            @id @default(cuid())
  section      AssessmentSection
  prompt       String
  passage      String? // reading passage / listening script (read aloud client-side)
  options      String[] // exactly 4
  correctIndex Int

  createdAt DateTime @default(now())

  @@index([section])
}

// One per candidate, ever — candidateProfileId is unique, enforcing the
// one-time rule. status COMPLETED is the gate checked by
// requireAssessedCandidate; the score itself is not a pass/fail bar, just a
// scored input into match weighting (see packages/matching-engine).
model CandidateAssessment {
  id                 String           @id @default(cuid())
  candidateProfileId String           @unique
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  status AssessmentStatus @default(IN_PROGRESS)

  // 0-100 overall + per-section-group breakdown, shown to HR. Null until
  // status flips to COMPLETED.
  score         Int?
  languageScore Int?
  aptitudeScore Int?
  skillScore    Int?

  answers CandidateAssessmentAnswer[]

  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

// Snapshotted question content, not a reference to AssessmentQuestion.id —
// required anyway since SKILL_BASED rows are AI-generated per-candidate and
// never live in the bank, and it keeps an honest record of exactly what a
// candidate was asked even if the bank changes later.
model CandidateAssessmentAnswer {
  id                    String              @id @default(cuid())
  candidateAssessmentId String
  candidateAssessment   CandidateAssessment @relation(fields: [candidateAssessmentId], references: [id], onDelete: Cascade)

  order         Int
  section       AssessmentSection
  prompt        String
  passage       String?
  options       String[]
  correctIndex  Int
  selectedIndex Int? // null until answered

  // Which of the candidate's listed skills this question targeted — only
  // set for SKILL_BASED rows.
  skillName String?

  @@index([candidateAssessmentId])
}

// A stored, event-driven match produced by the matching engine — created when
// a job is posted (scored against existing candidates) or when a candidate
// substantially edits their profile (re-scored against currently open jobs).
// Never computed live on page load; the candidate feed and the employer's
// "matched candidates" view both just read this table.
model Match {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  score      Float // 0-100
  breakdown  Json // per-criterion scores/weights/reasons, for explainability
  matchedAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([jobId, candidateId])
  @@index([candidateId, score])
  @@index([jobId, score])
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  payload Json
  read    Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
}

// One invocation of the crawler agent against an organization's public info
// (careers page, accessibility statement, etc).
model CrawlRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         CrawlStatus  @default(PENDING)
  startedAt      DateTime?
  finishedAt     DateTime?

  findings  CrawlFinding[]
  createdAt DateTime       @default(now())

  @@index([organizationId])
}

// A single extracted signal from a crawl run, consumed by the scoring agent.
model CrawlFinding {
  id             String       @id @default(cuid())
  crawlRunId     String
  crawlRun       CrawlRun     @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sourceUrl       String
  category        String // e.g. "careers-page-a11y", "accommodation-policy", "physical-access"
  rawContent      String?
  extractedSignal Json?

  createdAt DateTime @default(now())

  @@index([organizationId, category])
}

// A generated accessibility/inclusion score for a company or university,
// produced by the scoring agent from CrawlFindings (+ any manual input).
model AccessibilityScore {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  overallScore       Float
  breakdown          Json // per-category subscores + rationale
  methodologyVersion String
  generatedBy        String // agent identifier, e.g. "scoring-agent@v1"
  generatedAt        DateTime @default(now())

  @@index([organizationId, generatedAt])
}
