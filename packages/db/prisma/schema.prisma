// Shared schema for all Blackbox apps and agent services.
// Job-portal functionality here is intentionally minimal — it covers only what's
// been discussed so far (accounts, job postings, applications) and will grow as
// the rest of the job-portal feature set is scoped.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserRole {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum OrganizationType {
  COMPANY
  UNIVERSITY
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  INTERVIEWING
  OFFERED
  REJECTED
  WITHDRAWN
}

enum CrawlStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  passwordHash String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateProfile CandidateProfile?

  // Set when role = EMPLOYER; the company this user posts jobs on behalf of.
  employerOrgId String?
  employerOrg   Organization? @relation(fields: [employerOrgId], references: [id])

  @@index([employerOrgId])
}

model CandidateProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName            String
  headline            String?
  resumeUrl           String?
  accessibilityNeeds  String[] // e.g. "screen-reader", "captioning", "flexible-hours"

  // Populated by the matching agent from résumé/profile text. Query via raw SQL
  // (Prisma has no native vector query API) — see services/matching-agent.
  embedding Unsupported("vector(1536)")?

  applications Application[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Organization {
  id          String           @id @default(cuid())
  type        OrganizationType
  name        String
  website     String?
  description String?

  employerUsers       User[]
  jobs                Job[]
  crawlRuns           CrawlRun[]
  crawlFindings       CrawlFinding[]
  accessibilityScores AccessibilityScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model Job {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title                  String
  description            String
  location               String?
  remote                 Boolean  @default(false)
  employmentType         String? // e.g. "full-time", "contract"
  accommodationsOffered  String[]
  isOpen                 Boolean  @default(true)

  // Populated by the matching agent from the job description. Query via raw SQL.
  embedding Unsupported("vector(1536)")?

  applications Application[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([organizationId])
}

model Application {
  id          String            @id @default(cuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(SUBMITTED)
  coverNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, candidateId])
}

// One invocation of the crawler agent against an organization's public info
// (careers page, accessibility statement, etc).
model CrawlRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         CrawlStatus  @default(PENDING)
  startedAt      DateTime?
  finishedAt     DateTime?

  findings CrawlFinding[]
  createdAt DateTime @default(now())

  @@index([organizationId])
}

// A single extracted signal from a crawl run, consumed by the scoring agent.
model CrawlFinding {
  id             String       @id @default(cuid())
  crawlRunId     String
  crawlRun       CrawlRun     @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sourceUrl       String
  category        String // e.g. "careers-page-a11y", "accommodation-policy", "physical-access"
  rawContent      String?
  extractedSignal Json?

  createdAt DateTime @default(now())

  @@index([organizationId, category])
}

// A generated accessibility/inclusion score for a company or university,
// produced by the scoring agent from CrawlFindings (+ any manual input).
model AccessibilityScore {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  overallScore      Float
  breakdown         Json // per-category subscores + rationale
  methodologyVersion String
  generatedBy       String // agent identifier, e.g. "scoring-agent@v1"
  generatedAt       DateTime @default(now())

  @@index([organizationId, generatedAt])
}
